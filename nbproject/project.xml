<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.netbeans.org/ns/project/1">
  <type>org.netbeans.modules.ant.freeform</type>
  <configuration>
    <general-data xmlns="http://www.netbeans.org/ns/freeform-project/1">
      <name>EP1 - Reserva de salas</name>
      <folders>
        <source-folder><label>Fontes Java</label><type>java</type><location>src/main/java</location></source-folder>
        <source-folder><label>Testes Java</label><type>java</type><location>src/test/java</location></source-folder>
        <build-folder><location>build</location></build-folder>
      </folders>
      <ide-actions>
        <action name="build"><target>jar</target></action>
        <action name="clean"><target>clean</target></action>
        <action name="rebuild"><target>clean</target><target>jar</target></action>
        <action name="run"><target>run</target></action>
        <action name="test"><target>test</target></action>
        <action name="run.single"><target>run-single</target><context><property>run.class</property><folder>src/main/java</folder><pattern>.*\.java</pattern><format>java-name</format><arity><one-file-only/></arity></context></action>
      </ide-actions>
      <export><type>jar</type><location>build/ep1-netbeans.jar</location><build-target>jar</build-target><clean-target>clean</clean-target></export>
      <view>
        <items>
          <source-folder style="packages"><label>Fontes Java</label><location>src/main/java</location></source-folder>
          <source-folder style="packages"><label>Testes Java</label><location>src/test/java</location></source-folder>
          <source-file><location>build.xml</location></source-file>
          <source-file><location>README.md</location></source-file>
        </items>
        <context-menu>
          <ide-action name="run"/><ide-action name="build"/><ide-action name="test"/><ide-action name="clean"/>
          <action><label>Executar somente servidor</label><target>run-server</target></action>
          <action><label>Executar somente cliente GUI</label><target>run-client</target></action>
        </context-menu>
      </view>
    </general-data>
    <java-data xmlns="http://www.netbeans.org/ns/freeform-project-java/5">
      <compilation-unit>
        <package-root>src/main/java</package-root>
        <classpath mode="compile">lib/gson-2.14.0.jar</classpath>
        <classpath mode="execute">build/classes:lib/gson-2.14.0.jar</classpath>
        <built-to>build/classes</built-to><source-level>17</source-level>
      </compilation-unit>
      <compilation-unit>
        <package-root>src/test/java</package-root><unit-tests/>
        <classpath mode="compile">build/classes:lib/gson-2.14.0.jar</classpath>
        <classpath mode="execute">build/test-classes:build/classes:lib/gson-2.14.0.jar</classpath>
        <built-to>build/test-classes</built-to><source-level>17</source-level>
      </compilation-unit>
    </java-data>
  </configuration>
</project>
